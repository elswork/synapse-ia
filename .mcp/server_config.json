{
    "mcpServers": {
        "anticitera_core": {
            "command": "python3",
            "args": [
                "-m",
                "core_v2.infrastructure.adapters.mcp_server_adapter"
            ],
            "capabilities": [
                "telemetry",
                "strategic_consulting",
                "goal_management"
            ],
            "env": {
                "PYTHONPATH": "."
            }
        }
    },
    "shared_memory": {
        "location": "/context",
        "priority_files": [
            "current_goal.md",
            "glossary.md"
        ]
    }
}